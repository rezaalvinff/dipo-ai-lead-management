# =====================================================================
# DIPO AI Lead Management — contoh konfigurasi
# Salin menjadi .env:  cp .env.example .env
# JANGAN isi file ini dengan nilai asli. File ini PUBLIK.
# =====================================================================

# --- Mode aplikasi --------------------------------------------------
# development: WHATSAPP_PROVIDER wajib "simulated", CONVERSION_PROVIDER wajib "noop"
APP_ENV=development
SIMULATOR_ENABLED=true

# --- Provider (adapter) ---------------------------------------------
WHATSAPP_PROVIDER=simulated        # simulated | whatsapp_cloud
AI_PROVIDER=mock                   # mock | (nama provider LLM, ditentukan di Fase 4)
CONVERSION_PROVIDER=noop           # noop | meta_capi

# --- Database & Redis (nilai lokal Docker Compose) ------------------
POSTGRES_USER=dipo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dipo_leads
DATABASE_URL=postgresql+psycopg://dipo:changeme@postgres:5432/dipo_leads
REDIS_URL=redis://redis:6379/0

# --- Keamanan aplikasi ----------------------------------------------
JWT_SECRET=changeme-generate-a-long-random-string

# --- AI provider (kosongkan di development bila memakai mock) -------
AI_API_KEY=
AI_MODEL=

# --- Meta WhatsApp Cloud API (HANYA production, kosongkan di dev) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Meta Conversions API (HANYA production) ------------------------
META_PIXEL_OR_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
