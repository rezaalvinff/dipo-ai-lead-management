# =====================================================================
# DIPO AI Lead Management — contoh konfigurasi
# Salin menjadi .env:  cp .env.example .env
# JANGAN isi file ini dengan nilai asli. File ini PUBLIK di GitHub.
# =====================================================================

# --- Mode aplikasi --------------------------------------------------
# development: WHATSAPP_PROVIDER wajib "simulated", CONVERSION_PROVIDER wajib "noop".
# Jika dilanggar, aplikasi MENOLAK start.
APP_ENV=development
SIMULATOR_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- Provider (adapter) ---------------------------------------------
WHATSAPP_PROVIDER=simulated        # simulated | whatsapp_cloud
AI_PROVIDER=mock                   # mock (provider LLM sungguhan menyusul)
CONVERSION_PROVIDER=noop           # noop | meta_capi
JOB_QUEUE=arq                      # arq (worker via Redis) | inline (tanpa worker)

# --- Database & Redis (dipakai Docker Compose) ----------------------
POSTGRES_USER=dipo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dipo_leads
# Saat menjalankan backend TANPA Docker, isi DATABASE_URL & REDIS_URL ke localhost:
# DATABASE_URL=postgresql+psycopg://dipo:changeme@localhost:5432/dipo_leads
# REDIS_URL=redis://localhost:6379/0

# --- Keamanan aplikasi ----------------------------------------------
# Production: wajib string acak minimal 32 karakter.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# --- Seed data dummy (HANYA development) ----------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_DEFAULT_PASSWORD=changeme-dev-password

# --- Meta WhatsApp Cloud API ----------------------------------------
# Biarkan KOSONG sampai nomor WhatsApp API tersedia (Phase berikutnya).
# Untuk menguji webhook dengan payload dummy di development, Anda boleh mengisi
# WHATSAPP_APP_SECRET dan WHATSAPP_WEBHOOK_VERIFY_TOKEN dengan teks bebas (bukan nilai asli).
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Saklar pengaman tambahan: pesan sungguhan hanya terkirim bila
# APP_ENV=production DAN nilai ini true.
WHATSAPP_CLOUD_SEND_ENABLED=false

# --- Meta Conversions API (production, phase berikutnya) ------------
META_PIXEL_OR_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
